{
  "name": "courtvision-desktop",
  "version": "0.9.4",
  "description": "Aplicación local de captura y detección para clubes vivoo",
  "author": "vivoo",
  "private": true,
  "main": "src/main.cjs",
  "build": {
    "appId": "com.courtvision.desktop",
    "productName": "vivoo",
    "icon": "build/icon.png",
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "files": ["src/**/*", "build/icon.png", "package.json"],
    "extraResources": [{ "from": "runtime", "to": "runtime" }],
    "artifactName": "vivoo-${version}-${os}-${arch}.${ext}",
    "publish": [{ "provider": "github", "owner": "Operatorliquid", "repo": "vivoo", "releaseType": "release" }],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": { "sign": false },
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "scripts": {
    "dev": "electron .",
    "runtime:prepare": "node scripts/prepare-native-runtime.cjs",
    "agent:package": "python3 scripts/build-agent.py",
    "update:stage": "node scripts/stage-update.cjs",
    "package": "electron-builder --dir",
    "dist:mac": "node scripts/build-mac.cjs",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  }
}
