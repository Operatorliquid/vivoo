APP_ENV=local
VITE_API_BASE_URL=http://localhost:8000
AWS_REGION=us-east-1
AWS_S3_MEDIA_BUCKET=
AWS_CLOUDFRONT_DISTRIBUTION_DOMAIN=
DATABASE_URL=postgresql://courtvision:courtvision@localhost:5432/courtvision
LOCAL_AGENT_KEY=courtvision-local-agent
LOCAL_AGENT_SIGNING_SECRET=replace-with-a-random-secret
LOCAL_WORKER_KEY=courtvision-local-worker
OWNER_SESSION_SIGNING_SECRET=replace-with-at-least-32-random-characters
OWNER_SESSION_TTL_HOURS=720
PLAYER_ACCESS_SIGNING_SECRET=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
LOCAL_MEDIA_ROOT=/tmp/courtvision-media
PUBLIC_MEDIA_BASE_URL=http://localhost:8000
EVOLUTION_ENABLED=true
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_POSTGRES_PASSWORD=
EVOLUTION_INSTANCE=courtvision
HEALTH_REQUIRE_WORKER=false
HEALTH_WORKER_MAX_AGE_SECONDS=45
HEALTH_MIN_DISK_FREE_BYTES=536870912
